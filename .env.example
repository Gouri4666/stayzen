# ==============================================================================
# StayZen Resort & Hotel Management System - Environment Variables
# ==============================================================================
# Copy this file to .env and configure the values for your environment:
# cp .env.example .env

# Security Settings
SECRET_KEY=your-django-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL required)
DB_ENGINE=django.db.backends.mysql
DB_NAME=hotel_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL="StayZen Support <your_email@gmail.com>"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
