# ==============================================================================
# StayZen - Git Ignore Configuration
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database files & dumps (do not commit database contents)
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.db
*.sql
*.dump

# Invoices & billing documents (do not commit invoices)
media/invoices/
media/invoices/*
*invoice*.txt
*Invoice*.pdf
*invoice*.pdf

# User check-in identification & personal resumes
media/checkin_ids/
media/checkin_ids/*
media/event_checkin_ids/
media/event_checkin_ids/*
media/staff_resumes/
media/staff_resumes/*

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary & test files
/scratch/
test_output/
*.bak
